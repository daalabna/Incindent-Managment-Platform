HOST=127.0.0.1
PORT=4000
SENTINEL_MODE=distributed
POSTGRES_PORT=15432
DATABASE_URL=postgresql://sentinel:local-development-only@127.0.0.1:15432/sentinel
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://sentinel:local-development-only@127.0.0.1:5672
INFRA_NAMESPACE=sentinel
# Ops/AI ticks inside API. Set false when running a separate worker process.
EMBEDDED_WORKER=true
WORKER_PORT=4002
# Security (validated at startup via readSecurityConfig).
# false = open demo: /api/auth/me returns Local operator / admin (no login).
# true  = real sessions; create a user with: ADMIN_USERNAME=… ADMIN_PASSWORD=… npm run user:create
AUTH_REQUIRED=false
# true only behind HTTPS. For local http://127.0.0.1 set false or the session cookie will not stick.
COOKIE_SECURE=true
TRUSTED_PROXIES=
# Comma-separated Host headers permitted in addition to loopback names.
ALLOWED_HOSTS=
# Demo generator delay. Tests set a smaller value.
SIMULATION_TICK_MS=3000
# SQLite demo only when SENTINEL_MODE=local AND ALLOW_SQLITE=true.
# Production: SENTINEL_MODE=distributed. Import: npm run db:import-sqlite.
# ALLOW_SQLITE=true
# DATABASE_PATH=data/sentinel.db
DATABASE_PATH=data/sentinel.db

# AI is opt-in. Credentials stay on the worker, never in VITE_* variables.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini-2025-04-14
AI_DAILY_REQUEST_LIMIT=50
