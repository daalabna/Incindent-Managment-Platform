{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import tsx server/entry/api.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/entry/api.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:distributed": "tsx scripts/e2e-distributed.ts",
    "infra:up": "docker compose up -d --wait postgres redis rabbitmq",
    "infra:down": "docker compose stop postgres redis rabbitmq",
    "worker": "tsx server/entry/worker.ts",
    "db:import-sqlite": "tsx server/entry/import-sqlite.ts",
    "test:e2e": "playwright test",
    "user:create": "tsx scripts/create-user.ts",
    "ha:prepare": "tsx scripts/ha-prepare.ts",
    "ha:up": "docker compose --env-file .secrets/ha.env -f compose.ha.yaml up -d --build --wait",
    "ha:bootstrap": "tsx scripts/ha-bootstrap.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "benchmark:analytics": "tsx scripts/benchmark-analytics.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@tanstack/react-query": "^5.0.0",
    "amqplib": "^0.10.9",
    "fastify": "^5.0.0",
    "ioredis": "^5.8.0",
    "lucide-react": "^0.468.0",
    "openai": "^7.31.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.4",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  }
}
